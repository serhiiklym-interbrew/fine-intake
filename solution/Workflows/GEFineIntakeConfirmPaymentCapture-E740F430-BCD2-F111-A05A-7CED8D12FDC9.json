                        "inputs": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Bereits bestätigt — GE Fleet Bußgeld</title>\n<style>\n  body{margin:0;background:#f3f4f6;font-family:Segoe UI,Arial,sans-serif;color:#1f2933;}\n  .wrap{max-width:560px;margin:24px auto;background:#fff;border-radius:8px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.12);}\n  .head{background:#000000;color:#fff;padding:18px 24px;}\n  .head h1{margin:0;font-size:18px;font-weight:600;}\n  .bar{height:4px;background:#D1A33C;}\n  .body{padding:24px;}\n  .note{display:flex;align-items:center;gap:12px;background:#e8f5e9;border:1px solid #c6e8c9;border-radius:6px;padding:14px 16px;margin:0 0 20px;}\n  .note .tick{width:28px;height:28px;flex:0 0 28px;background:#2e7d32;color:#fff;border-radius:50%;text-align:center;line-height:28px;font-size:16px;font-weight:700;}\n  .note .txt{font-size:14px;line-height:1.4;}\n  table.det{width:100%;border-collapse:collapse;margin:0;font-size:14px;}\n  table.det td{padding:7px 10px;border-bottom:1px solid #eceff1;vertical-align:top;}\n  table.det td.k{color:#5a6b78;width:46%;}\n  table.det td.v{font-weight:600;}\n  .foot{padding:14px 24px;font-size:12px;color:#8a97a0;border-top:1px solid #eceff1;}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n  <div class=\"head\"><h1>Zahlung bereits bestätigt</h1></div>\n  <div class=\"bar\"></div>\n  <div class=\"body\">\n    <div class=\"note\">\n      <div class=\"tick\">&#10003;</div>\n      <div class=\"txt\">Dieses Bußgeld wurde bereits als bezahlt bestätigt. Es ist keine weitere Aktion erforderlich.</div>\n    </div>\n    <table class=\"det\">\n      <tr><td class=\"k\">Dokument</td><td class=\"v\">@{body('Run_script_GetForConfirm')?['result']?['fineType']}</td></tr>\n      <tr><td class=\"k\">Kennzeichen</td><td class=\"v\">@{body('Run_script_GetForConfirm')?['result']?['plateNumber']}</td></tr>\n      <tr><td class=\"k\">Aktenzeichen</td><td class=\"v\">@{body('Run_script_GetForConfirm')?['result']?['referenceNumber']}</td></tr>\n      @{if(empty(body('Run_script_GetForConfirm')?['result']?['amountText']), '', concat('<tr><td class=\"k\">Betrag</td><td class=\"v\">', body('Run_script_GetForConfirm')?['result']?['amountText'], '</td></tr>'))}\n    </table>\n  </div>\n  <div class=\"foot\">Mit freundlichen Grüßen, Fleet Team Germany &middot; Automatische Seite, bitte nicht antworten. Sie können dieses Fenster schließen.</div>\n</div>\n</body>\n</html>"
