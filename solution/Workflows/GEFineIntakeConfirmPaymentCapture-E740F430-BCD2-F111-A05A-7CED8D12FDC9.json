                      "inputs": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Zahlung bestätigen — GE Fleet Bußgeld</title>\n<style>\n  body{margin:0;background:#f3f4f6;font-family:Segoe UI,Arial,sans-serif;color:#1f2933;}\n  .wrap{max-width:560px;margin:24px auto;background:#fff;border-radius:8px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.12);}\n  .head{background:#000000;color:#fff;padding:18px 24px;}\n  .head h1{margin:0;font-size:18px;font-weight:600;}\n  .bar{height:4px;background:#D1A33C;}\n  .body{padding:24px;}\n  .intro{margin:0 0 18px;font-size:14px;line-height:1.5;}\n  table.det{width:100%;border-collapse:collapse;margin:0 0 20px;font-size:14px;}\n  table.det td{padding:7px 10px;border-bottom:1px solid #eceff1;vertical-align:top;}\n  table.det td.k{color:#5a6b78;width:46%;}\n  table.det td.v{font-weight:600;}\n  label.lbl{display:block;font-size:14px;font-weight:600;margin:4px 0 6px;}\n  input[type=date]{font-size:15px;padding:9px 10px;border:1px solid #c4ccd2;border-radius:6px;width:100%;box-sizing:border-box;}\n  button{margin-top:18px;background:#000000;color:#fff;border:0;border-radius:6px;padding:12px 20px;font-size:15px;font-weight:600;cursor:pointer;width:100%;}\n  button:hover{background:#214a5c;}\n  .foot{padding:14px 24px;font-size:12px;color:#8a97a0;border-top:1px solid #eceff1;}\n  .nojs{background:#fdecea;color:#8a1c12;padding:12px 24px;font-size:13px;}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n  <div class=\"head\"><h1>Bestätigen Sie die Zahlung Ihres Bußgeldes</h1></div>\n  <div class=\"bar\"></div>\n  <noscript><div class=\"nojs\">Bitte aktivieren Sie JavaScript in Ihrem Browser, um diese Bestätigung abzusenden.</div></noscript>\n  <div class=\"body\">\n    <p class=\"intro\">Bitte wählen Sie unten das Datum aus, an dem Sie das Bußgeld bezahlt haben, und klicken Sie anschließend auf <b>Zahlung bestätigen</b>.</p>\n    <table class=\"det\">\n      <tr><td class=\"k\">Dokument</td><td class=\"v\">@{body('Run_script_GetForConfirm')?['result']?['fineType']}</td></tr>\n      <tr><td class=\"k\">Kennzeichen</td><td class=\"v\">@{body('Run_script_GetForConfirm')?['result']?['plateNumber']}</td></tr>\n      <tr><td class=\"k\">Aktenzeichen</td><td class=\"v\">@{body('Run_script_GetForConfirm')?['result']?['referenceNumber']}</td></tr>\n      @{if(empty(body('Run_script_GetForConfirm')?['result']?['vendorName']), '', concat('<tr><td class=\"k\">Aussteller</td><td class=\"v\">', body('Run_script_GetForConfirm')?['result']?['vendorName'], '</td></tr>'))}\n      @{if(empty(body('Run_script_GetForConfirm')?['result']?['offenceDateText']), '', concat('<tr><td class=\"k\">Tatdatum</td><td class=\"v\">', body('Run_script_GetForConfirm')?['result']?['offenceDateText'], '</td></tr>'))}\n      @{if(empty(body('Run_script_GetForConfirm')?['result']?['dueDateText']), '', concat('<tr><td class=\"k\">Zahlungsfrist</td><td class=\"v\">', body('Run_script_GetForConfirm')?['result']?['dueDateText'], '</td></tr>'))}\n      @{if(empty(body('Run_script_GetForConfirm')?['result']?['amountText']), '', concat('<tr><td class=\"k\">Betrag</td><td class=\"v\">', body('Run_script_GetForConfirm')?['result']?['amountText'], '</td></tr>'))}\n    </table>\n    <form id=\"confirmForm\" method=\"get\" action=\"\">\n      <label class=\"lbl\" for=\"paymentDate\">Zahlungsdatum</label>\n      <input type=\"date\" id=\"paymentDate\" name=\"paymentDate\" required max=\"@{formatDateTime(utcNow(),'yyyy-MM-dd')}\">\n      <button type=\"submit\">Zahlung bestätigen</button>\n    </form>\n  </div>\n  <div class=\"foot\">Mit freundlichen Grüßen, Fleet Team Germany &middot; Automatische Seite, bitte nicht antworten.</div>\n</div>\n<script>\n(function(){\n  var f=document.getElementById('confirmForm');\n  if(!f) return;\n  var p=new URLSearchParams(window.location.search);\n  p.forEach(function(v,k){\n    if(k.toLowerCase()==='paymentdate') return;\n    var inp=document.createElement('input');\n    inp.type='hidden'; inp.name=k; inp.value=v;\n    f.appendChild(inp);\n  });\n})();\n</script>\n</body>\n</html>"
