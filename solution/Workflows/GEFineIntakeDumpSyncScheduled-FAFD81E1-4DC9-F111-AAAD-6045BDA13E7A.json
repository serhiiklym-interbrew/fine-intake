                  "parameters": {
                    "poster": "User",
                    "location": "Channel",
                    "body/recipient/groupId": "482dae98-318c-42d9-a7d5-54cc23968ef2",
                    "body/recipient/channelId": "19:_1NJtZj2ZMy00h9iDGPQD1N-_oaLv5Gq-0PBGSc0iVY1@thread.tacv2",
                    "body/messageBody": "<b>⚠️ GE DUMP not refreshed - source file too small</b><br>\nDumpFile.xlsx was under 400 KB, so DUMP_INPUT was NOT replaced and still holds the previous dump. Fines matching keeps working on slightly stale data - check the source export.<br>\n<b>Run:</b> @{workflow()?['run']?['name']}",
                    "body/subject": "⚠️ GE DUMP skipped - source too small"
